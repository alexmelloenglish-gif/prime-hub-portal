{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/cron/meet-attendance",
      "schedule": "0 4 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/dashboard/student",
      "destination": "/dashboard"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "chore/issue-58-prime-engine-closure": false
    }
  }
}
