{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "crons": [
    {
      "path": "/api/cron/drive-transcripts",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/ingest",
      "destination": "/api/pipeline/ingest"
    },
    {
      "source": "/dashboard/student",
      "destination": "/dashboard"
    }
  ]
}
