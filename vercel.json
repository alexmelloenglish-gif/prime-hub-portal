{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "npm ci",
  "buildCommand": "prisma generate && next build",
  "rewrites": [
    {
      "source": "/api/ingest",
      "destination": "/api/pipeline/ingest"
    },
    {
      "source": "/dashboard/student",
      "destination": "/dashboard"
    }
  ]
}
