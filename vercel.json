{
  "buildCommand": "prisma generate && next build",
  "rewrites": [
    {
      "source": "/api/pipeline/ingest",
      "destination": "/api/ingest"
    },
    {
      "source": "/api/ingest",
      "destination": "/api/ingest"
    },
    {
      "source": "/api/lessons",
      "destination": "/api/lessons"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ]
}
