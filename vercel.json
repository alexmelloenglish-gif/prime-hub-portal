{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "echo 'skip install'",
  "buildCommand": "echo 'No build required'",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/api/pipeline/ingest",
      "destination": "/api/ingest"
    },
    {
      "source": "/api/ingest",
      "destination": "/api/ingest"
    },
    {
      "source": "/api/lessons",
      "destination": "/api/lessons"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ]
}
