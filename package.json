{
  "name": "prime-hub-portal",
  "version": "1.0.0",
  "description": "Protected learning portal with Google auth and PostgreSQL-ready dashboard data",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "teacher-intelligence:self-test": "node scripts/teacher-intelligence-self-test.mjs && node scripts/pipeline-attempts-self-test.mjs",
    "student-dashboard:self-test": "node scripts/student-dashboard-contract-self-test.mjs && node scripts/canonical-dashboard-projection-self-test.mjs && node scripts/canonical-student-consistency-audit.mjs && node scripts/student-dashboard-contract-regression-self-test.mjs",
    "portfolio:truth-audit": "node scripts/portfolio-class-report-truth-audit.mjs",
    "verify:student-dashboard": "npm run student-dashboard:self-test && npm run canonical:validate:strict",
    "eligibility:self-test": "node scripts/eligibility-boundary-self-test.mjs",
    "canonical:validate": "node scripts/canonical-consistency-validator.mjs",
    "canonical:validate:strict": "node scripts/canonical-consistency-validator.mjs --strict",
    "build": "node scripts/rebuild-landing-assets.mjs && npm run teacher-intelligence:self-test && npm run student-dashboard:self-test && npm run eligibility:self-test && npm run canonical:validate:strict && npm run canonical-readback:g3:self-test && npm run canonical-independent-projection:g4:self-test && npm run canonical-learning-intelligence:g5:self-test && npm run g6:account-learner:self-test && prisma generate && next build",
    "vercel-build": "npm run build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "students:normalize": "node scripts/normalize-student-identities.mjs",
    "canonical-record-contract:self-test": "node scripts/canonical-learning-record-contract-self-test.mjs",
    "canonicalization:g2:self-test": "node scripts/canonicalization-g2-self-test.mjs",
    "canonical-readback:g3:self-test": "node scripts/canonical-readback-g3-self-test.mjs",
    "canonical-independent-projection:g4:self-test": "node scripts/canonical-independent-projection-g4-self-test.mjs",
    "canonical-learning-intelligence:g5:self-test": "node scripts/canonical-independent-learning-intelligence-g5-self-test.mjs",
    "g6:account-learner:self-test": "node scripts/g6-account-learner-relation-self-test.mjs",
    "db:migrate:deploy": "prisma migrate deploy",
    "learning-narrative:self-test": "node --experimental-strip-types scripts/learning-narrative-machine-self-test.mjs"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^5.8.0",
    "@vercel/oidc": "3.8.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "firebase-admin": "^13.8.0",
    "google-auth-library": "10.6.2",
    "lucide-react": "^0.344.0",
    "next": "^15.0.0",
    "next-auth": "^4.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.10.3",
    "sharp": "0.34.5",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.56.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.32",
    "typescript": "^5.3.3"
  }
}
