generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String?    @unique
  emailVerified DateTime?
  image         String?
  role          String     @default("student")
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  accounts      Account[]
  sessions      Session[]
  progress      Progress[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Course {
  id          String     @id @default(cuid())
  title       String     @unique
  description String     @db.Text
  level       String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  lessons     Lesson[]
  progress    Progress[]

  @@map("courses")
}

model Lesson {
  id          String    @id @default(cuid())
  title       String
  description String    @db.Text
  courseId    String
  order       Int
  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, order])
  @@index([scheduledAt])
  @@map("lessons")
}

model Progress {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  completed Int      @default(0)
  status    String   @default("in_progress")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("progress")
}

model PipelineRun {
  id                       String       @id @default(cuid())
  idempotencyKey           String       @unique
  studentEmail             String
  lessonId                 String
  status                   String       @default("received")
  promptOneSchemaVersion   String?
  promptOneArtifact        Json?
  promptThreeSchemaVersion String?
  promptThreeArtifact      Json?
  portfolioPatchId         String?
  portfolioApplyStatus     String?
  authorityStatus          String       @default("non_authoritative")
  errorCode                String?
  errorMessage             String?      @db.Text
  startedAt                DateTime     @default(now())
  completedAt              DateTime?
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt
  transcript               Transcript?
  reviewTasks              ReviewTask[]

  @@index([studentEmail, createdAt])
  @@index([status])
  @@map("pipeline_runs")
}

model ReviewTask {
  id            String      @id @default(cuid())
  pipelineRunId String
  studentEmail  String
  lessonId      String
  stage         String      @default("identity_review_required")
  reviewerId    String?
  reviewedAt    DateTime?
  decision      String?
  reason        String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  pipelineRun   PipelineRun @relation(fields: [pipelineRunId], references: [id], onDelete: Cascade)

  @@unique([pipelineRunId, stage])
  @@index([stage, createdAt])
  @@index([studentEmail, createdAt])
  @@map("review_tasks")
}

model Transcript {
  id            String              @id @default(cuid())
  pipelineRunId String              @unique
  externalId    String?
  studentEmail  String
  lessonId      String
  source        String
  effectiveAt   DateTime?
  recordedAt    DateTime?
  content       String              @db.Text
  metadata      Json?
  createdAt     DateTime            @default(now())
  pipelineRun   PipelineRun         @relation(fields: [pipelineRunId], references: [id], onDelete: Cascade)
  evidence      EvidenceCandidate[]

  @@index([studentEmail, effectiveAt])
  @@map("transcripts")
}

model EvidenceCandidate {
  id             String     @id @default(cuid())
  transcriptId   String
  candidateKey   String
  sourceSpan     String?
  observation    String     @db.Text
  category       String
  confidence     Float?
  state          String     @default("proposed")
  requiresReview Boolean    @default(true)
  createdAt      DateTime   @default(now())
  transcript     Transcript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)

  @@unique([transcriptId, candidateKey])
  @@index([state])
  @@map("evidence_candidates")
}

model LearningSignalProposal {
  id             String   @id @default(cuid())
  pipelineRunId  String
  proposalKey    String
  signal         String   @db.Text
  rationale      String   @db.Text
  evidenceIds    Json
  proposedState  String   @default("proposed")
  requiresReview Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@unique([pipelineRunId, proposalKey])
  @@map("learning_signal_proposals")
}

model TeacherInsightProposal {
  id             String   @id @default(cuid())
  pipelineRunId  String
  text           String   @db.Text
  evidenceIds    Json
  signalIds      Json
  authorType     String   @default("ai")
  isOfficial     Boolean  @default(false)
  requiresReview Boolean  @default(true)
  status         String   @default("proposed")
  createdAt      DateTime @default(now())

  @@unique([pipelineRunId])
  @@map("teacher_insight_proposals")
}

model ClassReportProjection {
  id                   String   @id @default(cuid())
  pipelineRunId        String
  reportId             String   @unique
  studentEmail         String
  studentId            String
  lessonId             String
  generatedAt          DateTime @default(now())
  promptVersion        String   @default("prompt-2.v2.0")
  projectionVersion    String   @default("projection-1")
  sourceReferences     Json
  sourceSnapshot       Json?
  content              Json
  documentStatus       String   @default("draft")
  implementationStatus String   @default("not_proven")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([studentEmail, lessonId])
  @@map("class_report_projections")
}

model PortfolioProjection {
  id            String   @id @default(cuid())
  studentEmail  String
  projectionKey String
  projection    Json
  version       Int      @default(1)
  sourceRunId   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([studentEmail, projectionKey])
  @@map("portfolio_projections")
}

model CoachingGuidance {
  id                    String   @id @default(cuid())
  pipelineRunId         String
  studentEmail          String
  studentId             String?
  teacherId             String?
  content               Json
  recommendationStatus  String   @default("ai_proposed")
  isPedagogicalDecision Boolean  @default(false)
  requiresHumanReview   Boolean  @default(true)
  sourceReferences      Json?
  documentStatus        String   @default("draft")
  implementationStatus  String   @default("not_proven")
  createdAt             DateTime @default(now())

  @@unique([pipelineRunId])
  @@map("coaching_guidance")
}

model PipelineEvent {
  id            String   @id @default(cuid())
  pipelineRunId String
  eventType     String
  aggregateType String
  aggregateId   String
  payload       Json
  createdAt     DateTime @default(now())

  @@unique([pipelineRunId, eventType, aggregateId])
  @@index([aggregateType, aggregateId])
  @@map("pipeline_events")
}
